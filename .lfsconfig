[lfs]
	url = https://huggingface.co/commaai/openpilot-lfs.git/info/lfs
	pushurl = https://huggingface.co/commaai/openpilot-lfs.git/info/lfs
	locksverify = false
	# TeslaPilot (as zoompilot): only a chestnut uses the big driving model (~776 MB). Keep its pointer
	# but exclude the object from install fetches; a chestnut build fetches it
	# (openpilot/selfdrive/modeld/big_model_source.py). Every other runtime file is a normal blob.
	fetchexclude = openpilot/selfdrive/modeld/models/big_driving_tinygrad.pkl
